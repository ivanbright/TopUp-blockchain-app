{
    "name": "topup-desktop",
    "version": "1.0.0",
    "description": "TopUp - Web3 Reputation Platform",
    "main": "electron/main.js",
    "productName": "TopUp",
   "icon": "electron/assets/icon",
   "build": {
    "appId": "com.topup.desktop",
    "productName": "TopUp",
    "icon": "electron/assets/icon",
    "win": {
      "icon": "electron/assets/icon.ico"
    },
    "linux": {
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "icon": "electron/assets/icon.icns"
    }
  },
    "scripts": {
        "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
        "dev:renderer": "vite",
        "dev:electron": "electron .",
        "build": "npm run build:renderer && npm run build:electron",
        "build:renderer": "vite build",
        "build:electron": "tsc -p tsconfig.main.json && electron-builder",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
    },
    "keywords": [
        "electron",
        "react",
        "web3",
        "reputation"
    ],
    "author": "codewithmugisha",
    "license": "MIT",
    "dependencies": {
        "@walletconnect/web3-provider": "^1.8.0",
        "electron-settings": "^4.0.2",
        "electron-updater": "^6.1.7",
        "framer-motion": "^10.16.4",
        "lucide-react": "^0.284.0",
        "node-machine-id": "^1.1.12",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.16.0",
        "web3modal": "^1.9.12"
    },
    "devDependencies": {
        "@types/react": "^18.2.21",
        "@types/react-dom": "^18.2.7",
        "@vitejs/plugin-react": "^4.0.4",
        "autoprefixer": "^10.4.15",
        "concurrently": "^8.2.1",
        "electron": "^26.2.1",
        "electron-builder": "^24.13.3",
        "postcss": "^8.4.29",
        "tailwindcss": "^3.3.3",
        "typescript": "^5.2.2",
        "vite": "^4.4.9",
        "wait-on": "^7.0.1"
    }
}
